# Copy to .env.local and fill in. Leave blank to run in demo mode (local test accounts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Who can open /admin (comma-separated emails). Required in production.
ADMIN_EMAILS=

# Email alerts to you (resend.com). Leave RESEND_API_KEY blank to just print alerts in the terminal.
RESEND_API_KEY=
ALERT_TO_EMAIL=
ALERT_FROM=
# Your site's public address, used for links inside alert emails (e.g. https://yourdomain.ca). Optional locally.
SITE_URL=

# Site-wide password gate for the private preview (leave blank locally). Set as a Cloudflare secret when deployed.
SITE_PASSWORD=
