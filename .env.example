# Copy to .env.local and fill in. Leave blank to run in demo mode (local test accounts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Who can open /admin (comma-separated emails). Required in production.
ADMIN_EMAILS=
